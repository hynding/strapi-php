{
    "name": "strapi/i18n",
    "description": "Internationalization: locales and localized content (port of @strapi/i18n server)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "strapi/core": "self.version",
        "strapi/utils": "self.version",
        "strapi/types": "self.version",
        "strapi/admin": "self.version"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/i18n",
            "status": "ported",
            "compatibleWith": "5.x",
            "kind": "plugin",
            "name": "i18n",
            "namespace": "Strapi\\Plugin\\I18n",
            "server": "strapi-server.php"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "server/src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\Plugin\\I18n\\Tests\\": "tests/"
        }
    }
}
