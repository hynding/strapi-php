{
    "name": "strapi/plugin-i18n",
    "description": "Internationalization: locales and localized content (port of @strapi/plugin-i18n server)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "strapi/core": "self.version"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/plugin-i18n",
            "status": "planned",
            "compatibleWith": "5.x"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "server/src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\Plugin\\I18n\\Tests\\": "tests/"
        }
    }
}
