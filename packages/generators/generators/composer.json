{
    "name": "strapi/generators",
    "description": "Code generators for APIs, controllers, services, policies (port of @strapi/generators)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0-beta.1",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "strapi/core": "self.version",
        "strapi/utils": "self.version",
        "strapi/types": "self.version",
        "symfony/console": "^7.2"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/generators",
            "status": "ported",
            "compatibleWith": "5.x",
            "namespace": "Strapi\\Generators"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\Generators\\Tests\\": "tests/"
        }
    }
}
