{
    "name": "strapi/phpstan-config",
    "description": "Shared PHPStan configuration (replaces @strapi/tsconfig and eslint-config-custom)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/phpstan-config",
            "status": "foundation",
            "compatibleWith": "5.x"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
