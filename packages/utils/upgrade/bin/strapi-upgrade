#!/usr/bin/env php
<?php

declare(strict_types=1);

// `strapi-upgrade`: port of @strapi/upgrade's bin/upgrade.js (`npx @strapi/upgrade`)

$autoloaders = [
    $GLOBALS['_composer_autoload_path'] ?? null,  // run through vendor/bin/strapi-upgrade (Composer 2.2+)
    __DIR__ . '/../../../../../../autoload.php',  // in the bundle: vendor/hynding/strapi-php/packages/utils/upgrade/bin
    __DIR__ . '/../../../../vendor/autoload.php', // the strapi-php monorepo
];

foreach ($autoloaders as $autoload) {
    if (is_string($autoload) && is_file($autoload)) {
        require $autoload;
        break;
    }
}

if (!class_exists(Strapi\Upgrade\Cli\Cli::class)) {
    fwrite(STDERR, "strapi-upgrade: run `composer install` first\n");
    exit(1);
}

exit(Strapi\Upgrade\Cli\Cli::run());
