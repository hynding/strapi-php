{
    "name": "strapi/api-tests",
    "description": "Helpers for running the upstream Jest HTTP suite against a PHP instance (port of @strapi/api-tests)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0-beta.1",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "strapi/core": "self.version",
        "strapi/utils": "self.version"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/api-tests",
            "status": "foundation",
            "compatibleWith": "5.x"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\ApiTests\\Tests\\": "tests/"
        }
    }
}
