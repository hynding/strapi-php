{
    "name": "strapi/strapi",
    "description": "Strapi CLI and entrypoint: bin/strapi start|develop|build|console (port of @strapi/strapi)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "strapi/core": "self.version",
        "symfony/console": "^7.2",
        "symfony/process": "^7.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/strapi",
            "status": "foundation",
            "compatibleWith": "5.x"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\Cli\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/strapi"
    ]
}
