{
    "name": "strapi/content-type-builder",
    "description": "Content-Type Builder: schema.json writer and API file generator (port of @strapi/content-type-builder server)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "strapi/core": "self.version",
        "strapi/generators": "self.version"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/content-type-builder",
            "status": "planned",
            "compatibleWith": "5.x"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "server/src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\ContentTypeBuilder\\Tests\\": "tests/"
        }
    }
}
