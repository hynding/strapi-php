{
    "name": "strapi/email",
    "description": "Email service and provider abstraction (port of @strapi/email server)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "strapi/core": "self.version",
        "symfony/mailer": "^7.2"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/email",
            "status": "planned",
            "compatibleWith": "5.x"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "server/src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\Email\\Tests\\": "tests/"
        }
    }
}
