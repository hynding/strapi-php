{
    "name": "strapi/email",
    "description": "Email service and provider abstraction (port of @strapi/email server)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0-beta.1",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "strapi/core": "self.version",
        "strapi/utils": "self.version",
        "strapi/types": "self.version",
        "strapi/admin": "self.version",
        "symfony/mailer": "^7.2",
        "strapi/provider-email-sendmail": "self.version"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/email",
            "status": "ported",
            "compatibleWith": "5.x",
            "kind": "plugin",
            "name": "email",
            "namespace": "Strapi\\Email",
            "server": "strapi-server.php"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "server/src/",
            "shared/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\Email\\Tests\\": "tests/"
        }
    }
}
