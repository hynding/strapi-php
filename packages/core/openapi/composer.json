{
    "name": "strapi/openapi",
    "description": "OpenAPI document generation from route schemas (port of @strapi/openapi)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0-beta.1",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "strapi/core": "self.version",
        "strapi/utils": "self.version",
        "strapi/types": "self.version"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/openapi",
            "status": "ported",
            "compatibleWith": "5.x",
            "namespace": "Strapi\\Openapi"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\Openapi\\Tests\\": "tests/"
        }
    }
}
