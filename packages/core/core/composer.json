{
    "name": "strapi/core",
    "description": "Strapi runtime: container, registries, loaders, middlewares, document service, core API (port of @strapi/core)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "strapi/database": "self.version",
        "strapi/utils": "self.version",
        "strapi/types": "self.version",
        "strapi/permissions": "self.version",
        "strapi/logger": "self.version",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "nikic/fast-route": "^1.3",
        "vlucas/phpdotenv": "^5.6",
        "dragonmantank/cron-expression": "^3.4",
        "firebase/php-jwt": "^6.11",
        "psr/http-message": "^2.0"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/core",
            "status": "foundation",
            "compatibleWith": "5.x"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\Core\\Tests\\": "tests/"
        }
    }
}
