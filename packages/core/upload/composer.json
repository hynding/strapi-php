{
    "name": "strapi/upload",
    "description": "Media library and upload providers (port of @strapi/upload server)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "strapi/core": "self.version",
        "intervention/image": "^3.11",
        "league/flysystem": "^3.29",
        "symfony/mime": "^7.2"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/upload",
            "status": "planned",
            "compatibleWith": "5.x"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "server/src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\Upload\\Tests\\": "tests/"
        }
    }
}
