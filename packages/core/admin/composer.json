{
    "name": "strapi/admin",
    "description": "Admin API: users, roles, permissions, API tokens, auth (port of @strapi/admin server). The React admin stays upstream's npm bundle.",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0-beta.1",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "strapi/core": "self.version",
        "strapi/data-transfer": "self.version",
        "strapi/utils": "self.version",
        "strapi/permissions": "self.version",
        "strapi/types": "self.version"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/admin",
            "status": "in-progress",
            "compatibleWith": "5.x",
            "namespace": "Strapi\\Admin"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "server/src/",
            "shared/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\Admin\\Tests\\": "tests/"
        }
    }
}
