{
    "name": "strapi/review-workflows",
    "description": "Review workflows \u2014 upstream EE; licence to be confirmed before porting (port of @strapi/review-workflows server)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0-beta.1",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "strapi/core": "self.version"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/review-workflows",
            "status": "blocked-licence",
            "compatibleWith": "5.x"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "server/src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\ReviewWorkflows\\Tests\\": "tests/"
        }
    }
}
