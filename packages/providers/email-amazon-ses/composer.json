{
    "name": "strapi/provider-email-amazon-ses",
    "description": "Amazon SES email provider (port of @strapi/provider-email-amazon-ses)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "strapi/email": "self.version",
        "symfony/amazon-mailer": "^7.2"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/provider-email-amazon-ses",
            "status": "planned",
            "compatibleWith": "5.x"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\Provider\\EmailAmazonSes\\Tests\\": "tests/"
        }
    }
}
