{
    "name": "strapi/provider-email-mailgun",
    "description": "Mailgun email provider (port of @strapi/provider-email-mailgun)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0-beta.1",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "strapi/utils": "self.version",
        "strapi/types": "self.version"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/provider-email-mailgun",
            "status": "ported",
            "compatibleWith": "5.x",
            "kind": "provider",
            "main": "Strapi\\Provider\\EmailMailgun\\EmailMailgun"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\Provider\\EmailMailgun\\Tests\\": "tests/"
        }
    }
}
