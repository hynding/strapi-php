{
    "name": "strapi/provider-upload-aws-s3",
    "description": "Amazon S3 upload provider (port of @strapi/provider-upload-aws-s3)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0-beta.1",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "strapi/utils": "self.version",
        "strapi/types": "self.version"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/provider-upload-aws-s3",
            "status": "ported",
            "compatibleWith": "5.x",
            "kind": "provider",
            "main": "Strapi\\Provider\\UploadAwsS3\\UploadAwsS3"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\Provider\\UploadAwsS3\\Tests\\": "tests/"
        }
    }
}
