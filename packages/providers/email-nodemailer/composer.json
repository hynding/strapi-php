{
    "name": "strapi/provider-email-nodemailer",
    "description": "SMTP email provider via symfony/mailer (port of @strapi/provider-email-nodemailer)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0-beta.1",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "strapi/utils": "self.version",
        "strapi/types": "self.version",
        "symfony/mailer": "^7.2"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/provider-email-nodemailer",
            "status": "ported",
            "compatibleWith": "5.x",
            "kind": "provider",
            "main": "Strapi\\Provider\\EmailNodemailer\\EmailNodemailer"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\Provider\\EmailNodemailer\\Tests\\": "tests/"
        }
    }
}
