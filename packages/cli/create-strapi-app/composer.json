{
    "name": "strapi/create-strapi-app",
    "description": "Project scaffolder behind `composer create-project strapi/app` (port of create-strapi-app)",
    "type": "library",
    "license": "MIT",
    "version": "5.56.0-beta.1",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "symfony/console": "^7.2",
        "symfony/filesystem": "^7.2"
    },
    "extra": {
        "strapi": {
            "upstream": "@strapi/create-strapi-app",
            "status": "planned",
            "compatibleWith": "5.x"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\CreateStrapiApp\\Tests\\": "tests/"
        }
    }
}
