{
    "name": "strapi/create-strapi-app",
    "description": "Generate a new Strapi application: `composer create-project strapi/create-strapi-app my-project` (port of create-strapi-app)",
    "type": "library",
    "keywords": [
        "create-strapi-app",
        "create",
        "new",
        "generate",
        "strapi"
    ],
    "license": "MIT",
    "version": "5.56.0-beta.1",
    "homepage": "https://github.com/hynding/strapi-php",
    "require": {
        "php": ">=8.3",
        "symfony/console": "^7.2",
        "symfony/process": "^7.2"
    },
    "extra": {
        "strapi": {
            "upstream": "create-strapi-app",
            "status": "ported",
            "compatibleWith": "5.x"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Strapi\\CreateStrapiApp\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/create-strapi-app"
    ],
    "scripts": {
        "post-create-project-cmd": "@php bin/create-strapi-app --in-place"
    }
}
