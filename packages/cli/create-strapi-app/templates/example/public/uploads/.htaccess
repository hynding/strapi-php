# Uploaded files keep their extension: nothing here may run as PHP, whatever the URL
# (public/.htaccess refuses these requests too; this holds where it is not read first).
<FilesMatch "\.(php[0-9]?|pht|phtm|phtml|phar|phps)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
