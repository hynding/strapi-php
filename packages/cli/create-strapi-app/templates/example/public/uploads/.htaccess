# Uploaded files keep their extension, in its case: nothing here may run as PHP, whatever the URL
# (AddHandler matches `.PHP` too, hence `(?i)`)
# (public/.htaccess refuses these requests too; this holds where it is not read first).
<FilesMatch "(?i)\.(php[0-9]?|pht|phtm|phtml|phar|phps)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
