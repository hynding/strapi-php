{
    "name": "strapi/getstarted",
    "description": "The upstream getstarted example project, PHP edition",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "hynding/strapi-php": "^5.56"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "develop": "@php bin/strapi develop",
        "start": "@php bin/strapi start",
        "build": "@php bin/strapi build",
        "strapi": "@php bin/strapi"
    },
    "extra": {
        "strapi": {
            "uuid": "getstarted"
        }
    },
    "config": {
        "allow-plugins": false
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
