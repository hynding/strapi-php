{
    "description": "A Strapi application",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-pdo_sqlite": "*",
        "hynding/strapi-php": "^5.56"
    },
    "scripts": {
        "build": "@php bin/strapi build",
        "develop": "@php bin/strapi develop",
        "start": "@php bin/strapi start",
        "strapi": "@php bin/strapi"
    },
    "config": {
        "sort-packages": true,
        "process-timeout": 0,
        "allow-plugins": false
    },
    "extra": {
        "strapi": {
            "uuid": "fixture-shop"
        }
    }
}
