{
  "kind": "collectionType",
  "collectionName": "announcements",
  "info": {
    "singularName": "announcement",
    "pluralName": "announcements",
    "displayName": "Announcement",
    "description": "A site-wide message. The order of `level.enum` is the severity order, lowest first."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "body": {
      "type": "text"
    },
    "level": {
      "type": "enumeration",
      "enum": ["info", "warning", "critical"],
      "default": "info",
      "required": true
    },
    "active": {
      "type": "boolean",
      "default": true,
      "required": true
    }
  }
}
