{
  "description": "The admin summary counts entries per level for an authenticated admin",
  "requires": [
    "admin"
  ],
  "seed": {
    "plugin::announcements.announcement": [
      {
        "title": "A",
        "level": "info"
      },
      {
        "title": "B",
        "level": "critical"
      },
      {
        "title": "C",
        "level": "critical",
        "active": false
      }
    ]
  },
  "steps": [
    {
      "auth": "admin",
      "request": {
        "method": "GET",
        "path": "/announcements/summary"
      },
      "expect": {
        "status": 200,
        "body": {
          "data": {
            "total": 3,
            "active": 2,
            "byLevel": {
              "info": 1,
              "warning": 0,
              "critical": 2
            }
          }
        }
      }
    }
  ]
}
